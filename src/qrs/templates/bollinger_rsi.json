{
  "id": "bollinger_rsi",
  "version": 1,
  "title": "Bollinger/RSI mean reversion",
  "description": "Long one contract when the close is below the lower Bollinger Band (20, 2) and RSI(14) is below 30; flat when the close is at or above the middle band, or RSI is above 50. Exit wins. Fills at the next session's open with commission and slippage.",
  "required_bar": "1D",
  "conditions": [
    "Range-bound markets: it buys sharp falls expecting a return to the 20-session average; a sustained downtrend can hold it in a losing position.",
    "Long or flat only; it never sells short.",
    "Daily bars. Signals are decided at the close and filled at the next session's open, with the backtest's commission and slippage."
  ],
  "fixture": {
    "declaration": {
      "name": "Bollinger/RSI template fixture",
      "columns": {
        "date": "Date",
        "open": "Open",
        "high": "High",
        "low": "Low",
        "close": "Close"
      },
      "date_format": "%Y-%m-%d",
      "price_unit": "currency",
      "calendar": null,
      "instrument": {
        "symbol": "FIX",
        "currency": "USD",
        "multiplier": 50,
        "tick_size": 0.25,
        "margin_init": 0.1,
        "margin_maint": 0.05,
        "expiry": "2030-12-31"
      },
      "evidence_class": "synthetic",
      "source": "qrs/templates/bollinger_rsi.csv: a constructed price path whose signals are worked out in tests/test_templates.py",
      "redistributable": true
    },
    "fills": [
      {
