{
  "id": "sma_crossover",
  "version": 1,
  "title": "SMA crossover",
  "description": "Long one contract when SMA 20 crosses above SMA 50; flat when it crosses below. Fills at the next session's open with commission and slippage.",
  "required_bar": "1D",
  "conditions": [
    "Trending markets: a trend must outlast the lag of the 20- and 50-session simple averages; sideways markets cause repeated losing trades.",
    "Long or flat only; it never sells short.",
    "Daily bars. Signals are decided at the close and filled at the next session's open, with the backtest's commission and slippage."
  ],
  "fixture": {
    "declaration": {
      "name": "SMA crossover template fixture",
      "columns": {
        "date": "Date",
        "open": "Open",
        "high": "High",
        "low": "Low",
        "close": "Close"
      },
      "date_format": "%Y-%m-%d",
      "price_unit": "currency",
      "calendar": null,
      "instrument": {
        "symbol": "FIX",
        "currency": "USD",
        "multiplier": 50,
        "tick_size": 0.25,
        "margin_init": 0.1,
        "margin_maint": 0.05,
        "expiry": "2030-12-31"
      },
      "evidence_class": "synthetic",
      "source": "qrs/templates/sma_crossover.csv: a constructed price path whose signals are worked out in tests/test_templates.py",
      "redistributable": true
    },
    "fills": [
